# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

def asc_api_key
  # Prefer the shared App Store Connect key — the same one brunstadtv-app uses,
  # exposed by the `bccmedia-testflight-api` Semaphore secret as BCCMEDIA_* env
  # vars. The key is account-level (team 6734NUF6AV), so it manages tv.brunstad.app
  # too. Fall back to the local fastlane/api_key.p8 for developer machines.
  if !ENV['BCCMEDIA_APP_STORE_CONNECT_KEY_ID'].to_s.empty?
    app_store_connect_api_key(
      key_id: ENV['BCCMEDIA_APP_STORE_CONNECT_KEY_ID'],
      issuer_id: ENV['BCCMEDIA_APP_STORE_CONNECT_ISSUER_ID'],
      key_content: ENV['BCCMEDIA_APP_STORE_CONNECT_KEY_CONTENT_BASE64'],
      is_key_content_base64: true,
      in_house: false,
    )
  else
    app_store_connect_api_key(
      key_id: "5U2YBV363X",
      issuer_id: "06076aaf-4461-4441-8091-5d372b544eb5",
      key_filepath: "fastlane/api_key.p8",
    )
  end
end

platform :ios do

  desc "Compute the next TestFlight build number and write it to fastlane/.next_build_number"
  lane :next_build_number do
    require "spaceship"
    # latest_testflight_build_number switched to the App Store Connect `buildUploads`
    # endpoint in fastlane 2.232.0, which doesn't return our existing builds — it
    # reported build 0, so we'd ship build 1. Query the `builds` endpoint directly
    # instead, the way the action itself did before 2.232.0.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)

    app = Spaceship::ConnectAPI::App.find("tv.brunstad.app")
    UI.user_error!("Could not find tv.brunstad.app on App Store Connect") unless app

    latest_build = Spaceship::ConnectAPI.get_builds(
      filter: {
        app: app.id,
        "preReleaseVersion.platform" => Spaceship::ConnectAPI::Platform.map("appletvos"),
      },
      # Override the default includes ("buildBetaDetail,betaBuildMetrics"); Apple now
      # rejects betaBuildMetrics as a relationship. We only need the base version field.
      includes: "preReleaseVersion",
      sort: "-uploadedDate",
      limit: 1,
    ).to_models.first

    latest = latest_build ? latest_build.version.to_i : 0
    next_num = latest + 1
    UI.message "Previous TestFlight max build: #{latest}. Next: #{next_num}"
    File.write(File.join(__dir__, ".next_build_number"), next_num.to_s)
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    if options[:build_number]
      increment_build_number_in_xcodeproj(
        xcodeproj: "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
        target: "BCC Media tvOS",
        build_number: options[:build_number].to_s,
      )
    end
    if !is_ci
      UI.user_error!("This lane should never be run on a non-CI machine. It would override the default keychain on your mac.")
      return
    end
    create_keychain(
      name: "temp_keychain",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      password: "",
      lock_when_sleeps: true,
      add_to_search_list: true
    )
    api_key = asc_api_key
    # CERTIFICATE_PASSWORD is set when the shared `ios-signing-certs` secret provides
    # the .p12 (same cert brunstadtv-app signs with). Locally the cert uses "1".
    import_certificate(
      certificate_path: "fastlane/certificate.p12",
      certificate_password: ENV["CERTIFICATE_PASSWORD"] || "1",
      keychain_name: "temp_keychain",
      keychain_password: "",
    )
    get_provisioning_profile(
      api_key: api_key,
      filename: "dist.mobileprovision",
      platform: "tvos",
    )
    disable_automatic_code_signing(
      path:  "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
    )
    update_project_provisioning(
      xcodeproj: "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
      profile: "dist.mobileprovision",
      code_signing_identity: "Apple Distribution"
    )
    update_project_team(
      path: "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
      teamid: options[:team_id],
    )
    sh("cd .. && ./scripts/build.sh pre")
    begin
      build_app(
        scheme: "BCC Media tvOS",
        destination: "generic/platform=tvOS",
        cloned_source_packages_path: "./tmp/build",
        skip_profile_detection: true,
        codesigning_identity: "Apple Distribution",
        xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=6734NUF6AV"
      )
    ensure
      sh("cd .. && ./scripts/build.sh post")
    end
    upload_to_testflight(
      distribute_external: true,
      changelog: "See the betatester group on telegram.",
      groups: [
        "Open beta"
      ]
    )
    sentry_debug_files_upload(
      auth_token: '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',
      org_slug: 'bcc-media-sti',
      project_slug: 'bccm-tvos',
      include_sources: true,
    )
  end

  lane :release do
    current_version_number = increment_version_number_in_xcodeproj(
      xcodeproj: "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
      target: "BCC Media tvOS",
    )
    current_build_number = increment_build_number_in_xcodeproj(
      xcodeproj: "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
      target: "BCC Media tvOS",
    )
    commit_version_bump(
      message: "chore(tvos): bump version to #{current_version_number}+#{current_build_number}",
      xcodeproj: "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
    )
    add_git_tag(
      grouping: "tvos",
      includes_lane: false,
      prefix: "v",
      build_number: current_version_number,
      postfix: "+"+current_build_number,
    )
    push_git_tags
  end

  desc "Submit an existing TestFlight build to the App Store for review"
  lane :promote_to_app_store do
    build_number = ENV['BUILD_NUMBER']
    UI.user_error!('BUILD_NUMBER env var is required') if build_number.to_s.empty?
    app_version = get_version_number(
      xcodeproj: "./BCC Media tvOS/BCC Media tvOS.xcodeproj",
      target: "BCC Media tvOS",
    )
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: "tv.brunstad.app",
      platform: "appletvos",
      app_version: app_version,
      build_number: build_number,
      release_notes: { 'en-US' => 'Bug fixes and improvements.' },
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end

end
